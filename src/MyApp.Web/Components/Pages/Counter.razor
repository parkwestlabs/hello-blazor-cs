@page "/counter"
@rendermode InteractiveServer

@using static Microsoft.FluentUI.AspNetCore.Components.Appearance

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<FluentCard Style="height: auto; max-width: 300px; padding: 24px;">
    <p role="status" style="padding-bottom: 1em;">
        Current count: <FluentBadge Appearance=" Neutral">@currentCount</FluentBadge>
    </p>

    <FluentButton Appearance="Accent" @onclick="IncrementCount">Click me</FluentButton>
</FluentCard>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
