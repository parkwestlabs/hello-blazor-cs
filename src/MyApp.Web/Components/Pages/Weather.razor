@page "/weather"
@inherits NotificationPageBase

@using static Microsoft.FluentUI.AspNetCore.Components.Align
@using static Microsoft.FluentUI.AspNetCore.Components.Appearance
@using static Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16
@using MyApp.Core.Interfaces
@using MyApp.Core.Models

@inject ILogger<Index> Logger
@inject IToastService ToastService
@inject IWeatherService WeatherService

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

<FluentDataGrid Items="@forecasts" Loading="@isLoading" Style="width: 100%; max-width: 800px; overflow-x: auto;">
    <PropertyColumn Title="Date" Property="@(c => c.Date)" Align="Start" />
    <PropertyColumn Title="Temp. (C)" Property="@(c => c.TemperatureC)" Align="Center" />
    <PropertyColumn Title="Temp. (F)" Property="@(c => c.TemperatureF)" Align="Center" />
    <PropertyColumn Title="Summary" Property="@(c => c.Summary)" Align="End" />
</FluentDataGrid>

<FluentButton Appearance="Accent" IconStart="@(new ArrowClockwise())" @onclick="() => RefreshAsync(false)" Class="weather-btn">
    Refresh Data
</FluentButton>

@code {
    private bool isLoading = true; // 💡 初期状態はロード中
    private IQueryable<WeatherForecast>? forecasts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(true);
    }

    private async Task RefreshAsync(bool useCache)
    {
        forecasts = null; // ローディング状態（ProgressRing）に戻す

        await ExecuteSafeAsync(
            action: async () =>
            {
                isLoading = true;
                var list = await WeatherService.GetActiveForecastsAsync(useCache);
                forecasts = list.AsQueryable();

                isLoading = false;
                ToastService.ShowSuccess("Weather data updated");
            },
            onError: () =>
            {
                isLoading = false;
            }
        );
    }
}

<style>
    @* default で ellipsis なので、ここでは全部表示する *@
    td[role="gridcell"] {
        text-overflow: clip !important;
    }

    .weather-btn {
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        margin-top: 20px;
    }
</style>
