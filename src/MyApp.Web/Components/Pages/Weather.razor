@page "/weather"

@* OnInitializedAsync を確実に1回しか走らなくしてチラつき防止 (Reactと同じ挙動) *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [StreamRendering]

@using static Microsoft.FluentUI.AspNetCore.Components.Align
@using MyApp.Core.Interfaces
@using MyApp.Core.Models

@inject IWeatherService WeatherService

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

<FluentDataGrid Items="@forecasts" Loading="@(forecasts == null)" Style="height:200px;">
    <PropertyColumn Title="Date" Property="@(c => c.Date)" Align="Start" />
    <PropertyColumn Title="Temp. (C)" Property="@(c => c.TemperatureC)" Align="Center" />
    <PropertyColumn Title="Temp. (F)" Property="@(c => c.TemperatureF)" Align="Center" />
    <PropertyColumn Title="Summary" Property="@(c => c.Summary)" Align="End" />
</FluentDataGrid>

@code {
    private IQueryable<WeatherForecast>? forecasts;

    protected override async Task OnInitializedAsync()
    {
        var list = await WeatherService.GetActiveForecastsAsync();
        forecasts = list.AsQueryable();
    }
}
