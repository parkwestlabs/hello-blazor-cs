@rendermode InteractiveServer

@using static Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
@using static Microsoft.FluentUI.AspNetCore.Components.Color

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon">
        <FluentIcon Value="@(new Navigation())" Color="Fill" />
    </label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Nav menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Home())">Home</FluentNavLink>
            <FluentNavLink Href="counter" Icon="@(new NumberSymbolSquare())">Counter</FluentNavLink>
            <FluentNavLink Href="weather" Icon="@(new WeatherPartlyCloudyDay())">Weather</FluentNavLink>
        </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
}
